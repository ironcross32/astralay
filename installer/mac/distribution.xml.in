<?xml version="1.0" encoding="utf-8"?>
<!-- The installer's pages and choices. build-pkg.sh fills in the @...@ placeholders. -->
<installer-gui-script minSpecVersion="2">
    <title>Astralay @VERSION@</title>
    <organization>me.ironlabs</organization>

    <!-- The plugin folders in /Library, for every user of the Mac. -->
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="@MIN_OS@"/>
        </allowed-os-versions>
    </volume-check>

    <license file="License.txt"/>

    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="clap"/>
        <line choice="standalone"/>
    </choices-outline>

    <choice id="vst3" title="VST3" description="The VST3 plugin, installed in /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="@IDENTIFIER@.pkg.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="The Audio Unit, installed in /Library/Audio/Plug-Ins/Components. Logic Pro and GarageBand use this format.">
        <pkg-ref id="@IDENTIFIER@.pkg.au"/>
    </choice>
    <choice id="clap" title="CLAP" description="The CLAP plugin, installed in /Library/Audio/Plug-Ins/CLAP.">
        <pkg-ref id="@IDENTIFIER@.pkg.clap"/>
    </choice>
    <choice id="standalone" title="Standalone application" description="Astralay as an application that runs without a host, installed in Applications.">
        <pkg-ref id="@IDENTIFIER@.pkg.standalone"/>
    </choice>

    <pkg-ref id="@IDENTIFIER@.pkg.vst3" version="@VERSION@" onConclusion="none">Astralay-vst3.pkg</pkg-ref>
    <pkg-ref id="@IDENTIFIER@.pkg.au" version="@VERSION@" onConclusion="none">Astralay-au.pkg</pkg-ref>
    <pkg-ref id="@IDENTIFIER@.pkg.clap" version="@VERSION@" onConclusion="none">Astralay-clap.pkg</pkg-ref>
    <pkg-ref id="@IDENTIFIER@.pkg.standalone" version="@VERSION@" onConclusion="none">Astralay-standalone.pkg</pkg-ref>
</installer-gui-script>
