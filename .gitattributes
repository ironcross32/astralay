# Normalize line endings in the repository; check out with the platform's native endings.
* text=auto

# Files that must keep LF regardless of platform.
*.sh text eol=lf
.gitmodules text eol=lf

# Windows-only files that must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.wav binary
*.aif binary
*.aiff binary
*.ttf binary
*.otf binary
